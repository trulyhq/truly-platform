{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "staging": {
      "distribution": "internal",
      "env": {
        "ENVIRONMENT": "staging",
        "APP_VARIANT": "staging"
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "ENVIRONMENT": "production",
        "APP_VARIANT": "production"
      }
    }
  }
}
