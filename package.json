{
  "name": "truly-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "sst:dev": "sst dev",
    "sst:deploy": "sst deploy",
    "dev:deploy": "turbo run build && sst dev",
    "secrets:set-dburl": "bash ./scripts/set-dburl.sh"
  },
  "devDependencies": {
    "aws-cdk-lib": "2.224.0",
    "constructs": "10.3.0",
    "dotenv": "^16.4.5",
    "react": "18.3.1",
    "sst": "^2.43.4",
    "turbo": "^2.8.19"
  },
  "overrides": {
    "aws-cdk-lib": "2.224.0",
    "constructs": "10.3.0",
    "@trpc/server": "10.45.4"
  },
  "packageManager": "npm@10.9.2"
}
